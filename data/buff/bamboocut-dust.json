  "FragrantSongDelicate": { "name": "Fragrant Song - Delicate", "shortName": "FSD", "duration": 10, "maxStack": 4 },
  "FragrantSongResonance": {
    "name": "Fragrant Song - Resonance",
    "shortName": "FSR",
    "hidden": true,
    "description": "Marks the Scarlet Spin throw that spent Fragrant Song, so the Resonances that throw summons crit with it. Every throw clears and re-primes this at its own start, which scopes it to one throw even though the next throw starts before this one's Resonances land. The duration only has to outlive the throw's own Resonances; scoping comes from the clear, not the expiry.",
    "duration": 2,
    "maxStack": 1,
    "refresh": false
  },
  "SoulReturn": { "name": "Soul Return", "shortName": "SR", "maxStack": 1, "refresh": true, "duration": 12 },
  "FlowerBurial": { "name": "Flower Burial", "duration": 12, "maxStack": 1, "refresh": false },
  "PhantomUmbrella": {
    "name": "Phantom Umbrella",
    "shortName": "PU",
    "description": "A summoned world object, not a stat buff. One exists per player: a new summon replaces the previous one rather than accumulating, and it expires after five seconds.",
    "duration": 5,
    "maxStack": 1,
    "refresh": true
  },
  "PhantomUmbrellaThrow": {
    "name": "Phantom Umbrella Summon Cadence",
    "shortName": "Cad",
    "hidden": true,
    "description": "Counts returning umbrella throws since the last summon. Scarlet Spin primes this to two, so the first returning throw reaches the cap of three and summons, and the next summons fall on the fourth, seventh, tenth and thirteenth throw of that cast. Reaching the cap consumes the count so the next three throws are counted again.",
    "maxStack": 3,
    "refresh": true,
    "onMaxStack": { "consume": "all", "trigger": "PhantomUmbrellaSummon" }
  },
  "Soulbound": {
